# Public Supabase read client (safe local placeholders; required for view reads)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-placeholder

# Server-only view mutation credentials (set in the deployment secret store)
SUPABASE_SERVICE_ROLE_KEY=
VIEW_COUNT_HASH_SECRET=

# Supplied automatically by Vercel; view mutations require the value "1"
VERCEL=

# Optional contact mail credentials; set both values or leave both blank
NEXT_EMAIL_ID=
NEXT_EMAIL_PASSWORD=

# Optional browser integrations and legacy URL helper
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_DEV_URL=http://localhost:3000
NEXT_PUBLIC_URL=https://example.invalid
