{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run content:build && next dev",
    "build": "npm run content:build && next build",
    "content:build": "velite",
    "content:dev": "velite --watch",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "start": "next start",
    "lint": "eslint .",
    "check": "npm run verify:toolchain && npm run content:build && npm run lint && npm run typecheck && npm test",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*./src/.{ts,tsx}": [
      "npm run lint --fix"
    ]
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "^2.0.0",
    "date-fns": "4.4.0",
    "framer-motion": "13.4.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^4.10.1",
    "react-multi-carousel": "^2.8.6",
    "react-spinners": "0.17.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^1.14.0",
    "yup": "^1.7.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.9",
    "@types/gtag.js": "^0.0.13",
    "@types/node": "24.13.4",
    "@types/nodemailer": "^6.4.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.14",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-mdx": "3.8.1",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "^8.0.3",
    "knip": "6.35.1",
    "lint-staged": "^13.2.3",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-img-size": "^1.0.1",
    "rehype-pretty-code": "^0.10.0",
    "rehype-slug": "^5.1.0",
    "supabase": "2.117.0",
    "tailwindcss": "3.3.3",
    "ts-node": "^10.9.1",
    "typescript": "6.0.3",
    "velite": "^0.4.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.0"
  }
}
