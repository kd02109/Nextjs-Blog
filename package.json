{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run content:build && next dev",
    "build": "npm run content:build && next build && npm run sitemap",
    "content:build": "velite",
    "content:dev": "velite --watch",
    "sitemap": "ts-node --project tsconfig.node.json ./sitemap.config.ts",
    "start": "next start",
    "lint": "eslint .",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "npm run content:build && tsc --noEmit"
  },
  "lint-staged": {
    "*./src/.{ts,tsx}": [
      "npm run lint --fix"
    ]
  },
  "dependencies": {
    "@giscus/react": "3.1.0",
    "@supabase/supabase-js": "2.116.0",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "10.4.14",
    "bufferutil": "^4.0.8",
    "cookies-next": "^4.1.1",
    "date-fns": "^2.30.0",
    "framer-motion": "13.2.0",
    "next": "16.3.5",
    "next-seo": "^6.1.0",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.2.1",
    "nodemailer": "10.0.9",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.10.1",
    "react-markdown": "^8.0.7",
    "react-multi-carousel": "^2.8.4",
    "react-spinners": "0.17.1",
    "react-syntax-highlighter": "^15.5.0",
    "rehype-autolink-headings": "^6.1.1",
    "rehype-pretty-code": "^0.10.0",
    "rehype-slug": "^5.1.0",
    "remark-gfm": "^3.0.1",
    "server-only": "^0.0.1",
    "shiki": "^0.14.3",
    "tailwindcss": "3.3.3",
    "type-fest": "^4.17.0",
    "utf-8-validate": "^6.0.3",
    "yup": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@types/gtag.js": "^0.0.13",
    "@types/node": "26.5.1",
    "@types/nodemailer": "^6.4.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "^15.5.7",
    "clsx": "^2.0.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-mdx": "^3.1.5",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.1",
    "rehype-img-size": "^1.0.1",
    "supabase": "^1.163.2",
    "tailwind-merge": "^1.14.0",
    "ts-node": "^10.9.1",
    "typescript": "6.0.3",
    "velite": "^0.4.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.0"
  }
}
